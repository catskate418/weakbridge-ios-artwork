    <string name="ui_media_setting">Управление музыкой</string>
    <string name="ui_media_setting_body">Управляй музыкой iPhone в плеере часов.</string>
    <string name="ui_low_power">Экономичная связь</string>
    <string name="ui_low_power_body">После подключения снижать приоритет Bluetooth-связи.</string>
    <string name="ui_group_notifications">Группировать по приложениям</string>
    <string name="ui_group_notifications_body">Собирать сообщения приложения в одну группу.</string>
    <string name="ui_hide_content">Скрывать содержимое</string>
    <string name="ui_hide_content_body">Показывать название приложения без текста сообщения.</string>
    <string name="ui_app_filters">Приложения</string>
    <string name="ui_app_filters_body">Выбери, какие приложения могут присылать уведомления на часы.</string>
    <string name="ui_no_apps">Приложения появятся здесь после первого полученного уведомления.</string>
    <string name="ui_categories">Категории</string>
    <string name="ui_categories_body">Категорию назначает iPhone. Фильтр по приложению позволяет выбрать точнее.</string>
    <string name="ui_quiet_hours">Тихие часы</string>
    <string name="ui_quiet_hours_body">Получать уведомления без вибрации в выбранное время.</string>
    <string name="ui_quiet_start">Начало</string>
    <string name="ui_quiet_end">Окончание</string>
    <string name="ui_quiet_equal">Одинаковое время начала и окончания — тишина весь день.</string>
    <string name="ui_cooldown">Повторные сигналы</string>
    <string name="ui_cooldown_body">Минимальный интервал между вибрациями одного приложения. Сообщения продолжают приходить.</string>
    <string name="ui_no_cooldown">Каждое новое уведомление</string>
    <string name="ui_seconds">%1$d с</string>
    <string name="ui_choose_hour">Выбери час</string>
    <string name="ui_diagnostics_toggle">Собирать диагностику</string>
    <string name="ui_diagnostics_body">Только локальные счётчики, без текста сообщений. Открой этот экран снова, чтобы обновить снимок.</string>
    <string name="ui_service_stopped">Служба моста остановлена.</string>
    <string name="ui_latest_event">Последнее событие связи</string>
    <string name="ui_copy_diagnostics">Скопировать диагностику</string>
    <string name="ui_copied">Скопировано</string>
